# Server
NODE_ENV=development
PORT=8000
LOCAL_IP_ADDRESS=0.0.0.0
CLIENT_URL=http://localhost:5173

# Pusher
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# MongoDB
DB_URL=
# Authentication
# ACCESS_TOKEN_EXPIRE is measured in hours.
# REFRESH_TOKEN_EXPIRE is measured in days.
ACCESS_TOKEN=
ACCESS_TOKEN_EXPIRE=
REFRESH_TOKEN=
REFRESH_TOKEN_EXPIRE=
ACTIVATION_SECRET=
RESET_PASSWORD_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@example.com
SMTP_PASSWORD=your_smtp_password_or_app_password

# Optional Redis support (currently disabled in config/redis.js)
# REDIS_URL=redis://127.0.0.1:6379
